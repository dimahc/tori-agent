{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "types": ["node"],
    "resolveJsonModule": true,
    "paths": {
      "@tori-agent/ontology": ["packages/ontology/src/index.ts"],
      "@tori-agent/core": ["packages/core/src/index.ts"]
    }
  }
}
