{
  "@context": "https://tori-agent.dev/ontology/2026/core/context",
  "@graph": [
    { "@id": "capability:review", "@type": "Capability", "label": "Review", "description": "Review implementation and artifacts" },
    {
      "@id": "role:reviewer",
      "@type": "Role",
      "label": "Reviewer",
      "description": "Read-only reviewer",
      "capability_ids": ["capability:review"],
      "permission_grants": [
        { "@id": "permission:reviewer:read", "@type": "PermissionGrant", "tool_id": "tool:read", "effect": "policy-effect:allow", "rationale": "Inspect repo" },
        { "@id": "permission:reviewer:bash", "@type": "PermissionGrant", "tool_id": "tool:bash", "effect": "policy-effect:allow", "rationale": "Run readonly verification and repo inspection commands", "command_globs": ["npm *", "node *", "pwd", "git status*", "git diff*", "git log*", "rg --files**"] },
        { "@id": "permission:reviewer:glob", "@type": "PermissionGrant", "tool_id": "tool:glob", "effect": "policy-effect:allow", "rationale": "Find files" },
        { "@id": "permission:reviewer:grep", "@type": "PermissionGrant", "tool_id": "tool:grep", "effect": "policy-effect:allow", "rationale": "Search files" },
        { "@id": "permission:reviewer:state", "@type": "PermissionGrant", "tool_id": "tool:project_state", "effect": "policy-effect:allow", "rationale": "Inspect artifact state" },
        { "@id": "permission:reviewer:artifacts", "@type": "PermissionGrant", "tool_id": "tool:check_artifacts", "effect": "policy-effect:allow", "rationale": "Check artifact graph" },
        { "@id": "permission:reviewer:checks", "@type": "PermissionGrant", "tool_id": "tool:run_mechanical_checks", "effect": "policy-effect:allow", "rationale": "Run verification" }
      ]
    },
    { "@id": "agent:reviewer:quality", "@type": "Agent", "label": "Reviewer quality", "description": "Quality reviewer", "role_ids": ["role:reviewer"], "capability_ids": ["capability:review"], "tool_ids": ["tool:read", "tool:bash", "tool:glob", "tool:grep", "tool:project_state", "tool:check_artifacts", "tool:run_mechanical_checks"], "prompt_ref": "prompt:reviewer", "metadata": { "color": "warning", "human_tone": false, "mode": "subagent", "temperature": 0.2, "runtime_ids": ["opencode", "kilocode"] } },
    { "@id": "agent:reviewer:challenge", "@type": "Agent", "label": "Reviewer challenge", "description": "Challenge reviewer", "role_ids": ["role:reviewer"], "capability_ids": ["capability:review"], "tool_ids": ["tool:read", "tool:bash", "tool:glob", "tool:grep", "tool:project_state", "tool:check_artifacts", "tool:run_mechanical_checks"], "prompt_ref": "prompt:reviewer", "metadata": { "color": "warning", "human_tone": false, "mode": "subagent", "temperature": 0.2, "runtime_ids": ["opencode", "kilocode"] } },
    { "@id": "agent:reviewer:enhance", "@type": "Agent", "label": "Reviewer enhance", "description": "Enhancement reviewer", "role_ids": ["role:reviewer"], "capability_ids": ["capability:review"], "tool_ids": ["tool:read", "tool:bash", "tool:glob", "tool:grep", "tool:project_state", "tool:check_artifacts", "tool:run_mechanical_checks"], "prompt_ref": "prompt:reviewer", "metadata": { "color": "warning", "human_tone": false, "mode": "subagent", "temperature": 0.2, "runtime_ids": ["opencode", "kilocode"] } }
  ]
}
