{
  "@context": "https://tori-agent.dev/ontology/2026/core/context",
  "@graph": [
    { "@id": "capability:review", "@type": "Capability", "label": "Review", "description": "Review implementation and artifacts" },
    {
      "@id": "role:reviewer",
      "@type": "Role",
      "label": "Reviewer",
      "description": "Read-only reviewer",
      "reasoning_mode_id": "reasoning-mode:falsification",
      "capability_ids": ["capability:review"],
      "permission_grants": [
        { "@id": "permission:reviewer:read", "@type": "PermissionGrant", "tool_id": "tool:read", "effect": "policy-effect:allow", "rationale": "Inspect repo" },
        { "@id": "permission:reviewer:structured-read", "@type": "PermissionGrant", "tool_id": "tool:structured_read", "effect": "policy-effect:allow", "rationale": "Inspect huge structured files safely" },
        { "@id": "permission:reviewer:bash", "@type": "PermissionGrant", "tool_id": "tool:bash", "effect": "policy-effect:allow", "rationale": "Run readonly verification, structured extraction, and repo inspection commands", "command_globs": ["pwd", "git status*", "git diff*", "git log*", "git show*", "git fetch*", "rg --files**", "find *", "jq *", "node --test *", "node --experimental-test-*", "node dist/*.mjs", "node packages/*/tests/verify-*.mjs", "npm run *", "npm test", "npm run test*", "pnpm run *", "yarn run *", "grep *", "rg *", "awk *", "cut *", "wc *", "sort *", "head *", "tail *", "cat *", "file *", "diff *", "ls *"] },
        { "@id": "permission:reviewer:glob", "@type": "PermissionGrant", "tool_id": "tool:glob", "effect": "policy-effect:allow", "rationale": "Find files" },
        { "@id": "permission:reviewer:grep", "@type": "PermissionGrant", "tool_id": "tool:grep", "effect": "policy-effect:allow", "rationale": "Search files" },
        { "@id": "permission:reviewer:state", "@type": "PermissionGrant", "tool_id": "tool:project_state", "effect": "policy-effect:allow", "rationale": "Inspect artifact state" },
        { "@id": "permission:reviewer:workflow-state", "@type": "PermissionGrant", "tool_id": "tool:workflow_state", "effect": "policy-effect:allow", "rationale": "Inspect workflow state before repeating audit work" },
        { "@id": "permission:reviewer:artifacts", "@type": "PermissionGrant", "tool_id": "tool:check_artifacts", "effect": "policy-effect:allow", "rationale": "Check artifact graph" },
        { "@id": "permission:reviewer:checks", "@type": "PermissionGrant", "tool_id": "tool:run_mechanical_checks", "effect": "policy-effect:allow", "rationale": "Run verification" }
      ]
    },
    {
      "@id": "policy:reviewer-tool-loop-cap",
      "@type": "Policy",
      "label": "Reviewer tool loop cap",
      "description": "Cap reviewer investigation, search, speculation, and repeated invocation loops; fail closed to needs-human workflow stage when workflow context exists.",
      "policy_kind_id": "policy-kind:execution-loop",
      "subject_role_ids": ["role:reviewer"],
      "max_identical_invocations": 2,
      "max_identical_failures": 2,
      "max_consecutive_failures": 2,
      "max_missing_context_failures": 1,
      "escalation_stage_id": "workflow-stage:needs-human"
    },
    { "@id": "agent:reviewer:quality", "@type": "Agent", "label": "Reviewer quality", "description": "Quality reviewer", "role_ids": ["role:reviewer"], "capability_ids": ["capability:review"], "tool_ids": ["tool:read", "tool:structured_read", "tool:bash", "tool:glob", "tool:grep", "tool:project_state", "tool:workflow_state", "tool:check_artifacts", "tool:run_mechanical_checks"], "prompt_ref": "prompt:reviewer", "metadata": { "color": "warning", "human_tone": false, "mode": "subagent", "temperature": 0.2, "runtime_ids": ["opencode", "kilocode"] } },
    { "@id": "agent:reviewer:challenge", "@type": "Agent", "label": "Reviewer challenge", "description": "Challenge reviewer", "role_ids": ["role:reviewer"], "capability_ids": ["capability:review"], "tool_ids": ["tool:read", "tool:structured_read", "tool:bash", "tool:glob", "tool:grep", "tool:project_state", "tool:workflow_state", "tool:check_artifacts", "tool:run_mechanical_checks"], "prompt_ref": "prompt:reviewer", "metadata": { "color": "warning", "human_tone": false, "mode": "subagent", "temperature": 0.2, "runtime_ids": ["opencode", "kilocode"] } },
    { "@id": "agent:reviewer:enhance", "@type": "Agent", "label": "Reviewer enhance", "description": "Enhancement reviewer", "role_ids": ["role:reviewer"], "capability_ids": ["capability:review"], "tool_ids": ["tool:read", "tool:structured_read", "tool:bash", "tool:glob", "tool:grep", "tool:project_state", "tool:workflow_state", "tool:check_artifacts", "tool:run_mechanical_checks"], "prompt_ref": "prompt:reviewer", "reasoning_mode_id": "reasoning-mode:impact-ranked", "metadata": { "color": "warning", "human_tone": false, "mode": "subagent", "temperature": 0.2, "runtime_ids": ["opencode", "kilocode"] } }
  ]
}
