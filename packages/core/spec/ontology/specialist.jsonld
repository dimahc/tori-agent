                        "npm run *",
                        "npm test",
                        "npm run test*",
                        "grep *",
                        "rg *",
                        "awk *",
                        "cut *",
                        "wc *",
                        "sort *",
                        "head *",
                        "tail *",
                        "cat *",
                        "file *",
                        "diff *",
                        "ls *",
                        "node dist/*.mjs",
                        "node packages/*/tests/verify-*.mjs",
                        "python3 *.py",
                        "python3 -m *",
                        "curl *",
                        "gh pr view*",
                        "gh pr diff*",
                        "gh issue list*",
                        "gh run view*"
                    ]
                },
                {
                    "@id": "permission:researcher:glob",
                    "@type": "PermissionGrant",
                    "tool_id": "tool:glob",
                    "effect": "policy-effect:allow",
                    "rationale": "Locate files"
                },
                {
                    "@id": "permission:researcher:grep",
                    "@type": "PermissionGrant",
                    "tool_id": "tool:grep",
                    "effect": "policy-effect:allow",
                    "rationale": "Search files"
                },
                {
                    "@id": "permission:researcher:webfetch",
                    "@type": "PermissionGrant",
                    "tool_id": "tool:webfetch",
                    "effect": "policy-effect:allow",
                    "rationale": "Fetch docs"
                },
                {
                    "@id": "permission:researcher:state",
                    "@type": "PermissionGrant",
                    "tool_id": "tool:project_state",
                    "effect": "policy-effect:allow",
                    "rationale": "Inspect artifact state"
                },
                {
                    "@id": "permission:researcher:workflow-state",
                    "@type": "PermissionGrant",
                    "tool_id": "tool:workflow_state",
                    "effect": "policy-effect:allow",
                    "rationale": "Inspect workflow state before repeating audit work"
                },
                {
                    "@id": "permission:researcher:artifacts",
                    "@type": "PermissionGrant",
                    "tool_id": "tool:check_artifacts",
                    "effect": "policy-effect:allow",
                    "rationale": "Check artifact graph"
                },
                {
                    "@id": "permission:researcher:checks",
                    "@type": "PermissionGrant",
                    "tool_id": "tool:run_mechanical_checks",
                    "effect": "policy-effect:allow",
                    "rationale": "Run verification"
                },
                {
                    "@id": "permission:researcher:checkpoint",
                    "@type": "PermissionGrant",
                    "tool_id": "tool:save_checkpoint",
                    "effect": "policy-effect:allow",
                    "rationale": "Persist continuation"
                }
            ]
        },
        {
            "@id": "policy:specialist-tool-loop-cap",
            "@type": "Policy",
            "label": "Specialist tool loop cap",
            "description": "Cap specialist investigation, search, speculation, and repeated invocation loops; preserve strict fail-closed escalation when workflow context exists.",
            "policy_kind_id": "policy-kind:execution-loop",
            "subject_agent_ids": [
                "agent:specialist:software-architect",
                "agent:specialist:software-engineer",
                "agent:specialist:infrastructure",
                "agent:specialist:security",
                "agent:specialist:researcher"
            ],
            "max_identical_invocations": 2,
            "max_identical_failures": 2,
            "max_consecutive_failures": 3,
            "max_missing_context_failures": 1,
            "escalation_stage_id": "workflow-stage:needs-human"
        },
