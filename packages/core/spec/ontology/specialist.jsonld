        {
            "@id": "role:software_architect",
            "@type": "Role",
            "label": "Software architect",
            "description": "Architecture specialist",
            "reasoning_mode_id": "reasoning-mode:compare-then-decide",
            "capability_ids": [
                "capability:software-architecture",
                "capability:implementation"
            ],
            "permission_grants": [
                {
                    "@id": "permission:architect:read",
                    "@type": "PermissionGrant",
                    "tool_id": "tool:read",
                    "effect": "policy-effect:allow",
                    "rationale": "Inspect repo"
                },
                {
                    "@id": "permission:architect:structured-read",
                    "@type": "PermissionGrant",
                    "tool_id": "tool:structured_read",
                    "effect": "policy-effect:allow",
                    "rationale": "Inspect huge structured files safely"
                },
                {
                    "@id": "permission:architect:write",
                    "@type": "PermissionGrant",
                    "tool_id": "tool:write",
                    "effect": "policy-effect:allow",
                    "rationale": "Implement changes",
                    "path_globs": [
                        "**"
                    ]
                },
                {
                    "@id": "permission:architect:edit",
                    "@type": "PermissionGrant",
                    "tool_id": "tool:edit",
                    "effect": "policy-effect:allow",
                    "rationale": "Modify files",
                    "path_globs": [
                        "**"
                    ]
                },
                {
                    "@id": "permission:architect:bash",
                    "@type": "PermissionGrant",
                    "tool_id": "tool:bash",
                    "effect": "policy-effect:allow",
                    "rationale": "Run build/test, structured extraction, and readonly repo inspection",
                    "command_globs": [
                        "pwd",
                        "git status*",
                        "git diff*",
                        "git log*",
                        "git show*",
                        "git fetch*",
                        "rg --files**",
                        "find *",
                        "jq *",
                        "node --test *",
                        "node --experimental-test-*",
                        "npm run *",
                        "npm test",
                        "npm run test*",
                        "grep *",
                        "rg *",
                        "awk *",
                        "cut *",
                        "wc *",
                        "sort *",
                        "head *",
                        "tail *",
                        "cat *",
                        "file *",
                        "diff *",
                        "ls *",
                        "node *.js",
                        "node *.mjs",
                        "node dist/*.mjs",
                        "node packages/*/tests/verify-*.mjs",
                        "python3 *.py",
                        "python3 -m *",
                        "python *.py",
                        "python -m *",
                        "npx *",
                        "tsc *",
                        "eslint *",
                        "prettier *",
                        "npm *",
                        "pnpm *",
                        "yarn *",
                        "sed *",
                        "pip install*",
                        "uv *",
                        "poetry *",
                        "ruff *",
                        "gh pr view*",
                        "gh pr diff*",
                        "gh issue list*",
                        "gh run view*",
                        "ps *",
                        "free",
                        "free *",
                        "du *",
                        "df *",
                        "lsof *",
                        "ss *",
                        "htop",
                        "htop *",
                        "gitleaks *",
                        "git-secrets *",
                        "pre-commit *"
                    ]
                },
                {
                    "@id": "permission:architect:glob",
                    "@type": "PermissionGrant",
                    "tool_id": "tool:glob",
                    "effect": "policy-effect:allow",
                    "rationale": "Locate files"
                },
                {
                    "@id": "permission:architect:grep",
                    "@type": "PermissionGrant",
                    "tool_id": "tool:grep",
                    "effect": "policy-effect:allow",
                    "rationale": "Search files"
                },
                {
                    "@id": "permission:architect:state",
                    "@type": "PermissionGrant",
                    "tool_id": "tool:project_state",
                    "effect": "policy-effect:allow",
                    "rationale": "Inspect artifact state"
                },
                {
                    "@id": "permission:architect:workflow-state",
                    "@type": "PermissionGrant",
                    "tool_id": "tool:workflow_state",
                    "effect": "policy-effect:allow",
                    "rationale": "Inspect workflow state before repeating audit work"
                },
                {
                    "@id": "permission:architect:artifacts",
                    "@type": "PermissionGrant",
                    "tool_id": "tool:check_artifacts",
                    "effect": "policy-effect:allow",
                    "rationale": "Check artifact graph"
                },
                {
                    "@id": "permission:architect:checks",
                    "@type": "PermissionGrant",
                    "tool_id": "tool:run_mechanical_checks",
                    "effect": "policy-effect:allow",
                    "rationale": "Run verification"
                },
                {
                    "@id": "permission:architect:checkpoint",
                    "@type": "PermissionGrant",
                    "tool_id": "tool:save_checkpoint",
                    "effect": "policy-effect:allow",
                    "rationale": "Persist continuation"
                }
            ]
        },
