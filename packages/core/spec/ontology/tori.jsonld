            "@id": "policy:tori-no-direct-mutation",
            "@type": "Policy",
            "label": "Tori no direct mutation",
            "description": "Tori may not use substantive mutation tools directly",
            "policy_kind_id": "policy-kind:authorization",
            "effect": "policy-effect:deny",
            "subject_agent_ids": [
                "agent:tori"
            ],
            "tool_ids": [
