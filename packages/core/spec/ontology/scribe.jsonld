{
  "@context": "https://tori-agent.dev/ontology/2026/core/context",
  "@graph": [
    { "@id": "capability:artifact-generation", "@type": "Capability", "label": "Artifact generation", "description": "Produce managed artifacts" },
    { "@id": "capability:artifact-writing", "@type": "Capability", "label": "Artifact writing", "description": "Write managed markdown artifacts" },
    { "@id": "tool:mark_block_done", "@type": "Tool", "label": "mark_block_done", "description": "Mark exec-plan block complete", "capability_ids": ["capability:artifact-generation"] },
    { "@id": "tool:complete_plan", "@type": "Tool", "label": "complete_plan", "description": "Complete exec-plan when all blocks are done", "capability_ids": ["capability:artifact-generation"] },
    { "@id": "tool:register_spec", "@type": "Tool", "label": "register_spec", "description": "Create managed spec artifact", "capability_ids": ["capability:artifact-generation"] },
    {
      "@id": "role:scribe",
      "@type": "Role",
      "label": "Scribe",
      "description": "Writes only delegated managed artifacts",
      "capability_ids": ["capability:artifact-generation", "capability:artifact-writing"],
      "permission_grants": [
        { "@id": "permission:scribe:read", "@type": "PermissionGrant", "tool_id": "tool:read", "effect": "policy-effect:allow", "rationale": "Inspect files" },
        { "@id": "permission:scribe:write", "@type": "PermissionGrant", "tool_id": "tool:write", "effect": "policy-effect:allow", "rationale": "Write managed artifacts", "path_globs": [".opencode/**", ".kilocode/**", "docs/**", "README.md", "CHANGELOG.md"] },
        { "@id": "permission:scribe:edit", "@type": "PermissionGrant", "tool_id": "tool:edit", "effect": "policy-effect:allow", "rationale": "Edit managed artifacts", "path_globs": [".opencode/**", ".kilocode/**", "docs/**", "README.md", "CHANGELOG.md"] },
        { "@id": "permission:scribe:block", "@type": "PermissionGrant", "tool_id": "tool:mark_block_done", "effect": "policy-effect:allow", "rationale": "Update exec plan blocks" },
        { "@id": "permission:scribe:complete-plan", "@type": "PermissionGrant", "tool_id": "tool:complete_plan", "effect": "policy-effect:allow", "rationale": "Complete verified exec plans" },
        { "@id": "permission:scribe:register-spec", "@type": "PermissionGrant", "tool_id": "tool:register_spec", "effect": "policy-effect:allow", "rationale": "Create managed specs" },
        { "@id": "permission:scribe:glob", "@type": "PermissionGrant", "tool_id": "tool:glob", "effect": "policy-effect:allow", "rationale": "Find files" },
        { "@id": "permission:scribe:grep", "@type": "PermissionGrant", "tool_id": "tool:grep", "effect": "policy-effect:allow", "rationale": "Search files" },
        { "@id": "permission:scribe:question", "@type": "PermissionGrant", "tool_id": "tool:question", "effect": "policy-effect:allow", "rationale": "Clarify delegated artifact requirement" },
        { "@id": "permission:scribe:state", "@type": "PermissionGrant", "tool_id": "tool:project_state", "effect": "policy-effect:allow", "rationale": "Inspect artifact state" },
        { "@id": "permission:scribe:artifacts", "@type": "PermissionGrant", "tool_id": "tool:check_artifacts", "effect": "policy-effect:allow", "rationale": "Check artifact graph" },
        { "@id": "permission:scribe:checks", "@type": "PermissionGrant", "tool_id": "tool:run_mechanical_checks", "effect": "policy-effect:allow", "rationale": "Run verification" },
        { "@id": "permission:scribe:bash", "@type": "PermissionGrant", "tool_id": "tool:bash", "effect": "policy-effect:allow", "rationale": "Inspect git history for changelog and release notes", "command_globs": ["git status*", "git diff*", "git log*", "git show*"] },
        { "@id": "permission:scribe:workflow-state", "@type": "PermissionGrant", "tool_id": "tool:workflow_state", "effect": "policy-effect:allow", "rationale": "Read workflow run state for artifact context" }
      ]
    },
    { "@id": "agent:scribe:specification", "@type": "Agent", "label": "Scribe specification", "description": "Writes specs", "role_ids": ["role:scribe"], "capability_ids": ["capability:artifact-generation", "capability:artifact-writing"], "tool_ids": ["tool:read", "tool:write", "tool:edit", "tool:mark_block_done", "tool:complete_plan", "tool:register_spec", "tool:glob", "tool:grep", "tool:question", "tool:project_state", "tool:workflow_state", "tool:bash", "tool:check_artifacts", "tool:run_mechanical_checks"], "prompt_ref": "prompt:scribe", "metadata": { "color": "info", "human_tone": false, "mode": "subagent", "temperature": 0.1, "runtime_ids": ["opencode", "kilocode"] } },
    { "@id": "agent:scribe:adr", "@type": "Agent", "label": "Scribe adr", "description": "Writes ADRs", "role_ids": ["role:scribe"], "capability_ids": ["capability:artifact-generation", "capability:artifact-writing"], "tool_ids": ["tool:read", "tool:write", "tool:edit", "tool:mark_block_done", "tool:complete_plan", "tool:register_spec", "tool:glob", "tool:grep", "tool:question", "tool:project_state", "tool:workflow_state", "tool:bash", "tool:check_artifacts", "tool:run_mechanical_checks"], "prompt_ref": "prompt:scribe", "metadata": { "color": "info", "human_tone": false, "mode": "subagent", "temperature": 0.1, "runtime_ids": ["opencode", "kilocode"] } },
    { "@id": "agent:scribe:release-note", "@type": "Agent", "label": "Scribe release note", "description": "Writes release notes", "role_ids": ["role:scribe"], "capability_ids": ["capability:artifact-generation", "capability:artifact-writing"], "tool_ids": ["tool:read", "tool:write", "tool:edit", "tool:mark_block_done", "tool:complete_plan", "tool:register_spec", "tool:glob", "tool:grep", "tool:question", "tool:project_state", "tool:workflow_state", "tool:bash", "tool:check_artifacts", "tool:run_mechanical_checks"], "prompt_ref": "prompt:scribe", "metadata": { "color": "info", "human_tone": false, "mode": "subagent", "temperature": 0.1, "runtime_ids": ["opencode", "kilocode"] } },
    { "@id": "agent:scribe:documentation", "@type": "Agent", "label": "Scribe documentation", "description": "Writes docs", "role_ids": ["role:scribe"], "capability_ids": ["capability:artifact-generation", "capability:artifact-writing"], "tool_ids": ["tool:read", "tool:write", "tool:edit", "tool:mark_block_done", "tool:complete_plan", "tool:register_spec", "tool:glob", "tool:grep", "tool:question", "tool:project_state", "tool:workflow_state", "tool:bash", "tool:check_artifacts", "tool:run_mechanical_checks"], "prompt_ref": "prompt:scribe", "metadata": { "color": "info", "human_tone": false, "mode": "subagent", "temperature": 0.1, "runtime_ids": ["opencode", "kilocode"] } },
    { "@id": "agent:scribe:changelog", "@type": "Agent", "label": "Scribe changelog", "description": "Writes changelog", "role_ids": ["role:scribe"], "capability_ids": ["capability:artifact-generation", "capability:artifact-writing"], "tool_ids": ["tool:read", "tool:write", "tool:edit", "tool:mark_block_done", "tool:complete_plan", "tool:register_spec", "tool:glob", "tool:grep", "tool:question", "tool:project_state", "tool:workflow_state", "tool:bash", "tool:check_artifacts", "tool:run_mechanical_checks"], "prompt_ref": "prompt:scribe", "metadata": { "color": "info", "human_tone": false, "mode": "subagent", "temperature": 0.1, "runtime_ids": ["opencode", "kilocode"] } },
    { "@id": "agent:scribe:plan", "@type": "Agent", "label": "Scribe plan", "description": "Writes exec plans", "role_ids": ["role:scribe"], "capability_ids": ["capability:artifact-generation", "capability:artifact-writing"], "tool_ids": ["tool:read", "tool:write", "tool:edit", "tool:mark_block_done", "tool:complete_plan", "tool:register_spec", "tool:glob", "tool:grep", "tool:question", "tool:project_state", "tool:workflow_state", "tool:bash", "tool:check_artifacts", "tool:run_mechanical_checks"], "prompt_ref": "prompt:scribe", "metadata": { "color": "info", "human_tone": false, "mode": "subagent", "temperature": 0.1, "runtime_ids": ["opencode", "kilocode"] } }
  ]
}
